# Copy to .env (repo root for docker compose, or backend/.env when running the API directly).
# Never commit real credentials. Connector API keys will be added here as each source is approved.

ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://marketpulse:marketpulse@localhost:5432/marketpulse
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Background syncing of enabled sources (off by default).
SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=60

# Bluesky. Leave blank to use the public API. If search needs a signed-in account,
# create an app password at bsky.app > Settings > App passwords and set both values.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Insight writing with Claude (off by default). When on, the fact sheet for a watchlist
# (aggregate numbers and up to 3 example posts per term) is sent to the Anthropic API.
# Without it, insight cards come from templates. See docs/insights.md.
INSIGHTS_LLM_ENABLED=false
ANTHROPIC_API_KEY=
INSIGHTS_MODEL=claude-opus-5-5
